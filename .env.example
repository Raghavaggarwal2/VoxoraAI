# Voxora AI - Environment Configuration Example
# Copy this file to .env and replace with your actual API keys

# Required for Whisper speech transcription via Groq Cloud
GROQ_API_KEY=gsk_your_groq_api_key_here

# Required for summarization, structured extraction, and RAG Q&A via Mistral AI
MISTRALAI_API_KEY=your_mistral_api_key_here

# Whisper model name (default: whisper-large-v3)
WHISPER_MODEL=whisper-large-v3

# Optional: Ollama configuration if using local LLMs
OLLAMA_API_KEY=

# Optional: path to ffmpeg binary or directory if not in PATH
FFMPEG_LOCATION=

