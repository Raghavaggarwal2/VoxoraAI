# Voxora AI - Environment Configuration (Groq-Only Dual-Account Architecture)
# Copy this file to .env and replace with your actual API keys

# ── Groq Account 1: Dedicated for Audio Speech-to-Text (Whisper) ──
# Free tier key from Groq Account 1: https://console.groq.com/keys
GROQ_API_KEY=gsk_account1_whisper_key_here
WHISPER_MODEL=whisper-large-v3

# ── Groq Account 2: Dedicated for AI Intelligence & Reasoning ──
# (Summaries, Key Decisions, Action Items, Mind Map, and RAG Q&A)
# Free tier key from Groq Account 2: https://console.groq.com/keys
# (If omitted, system safely falls back to GROQ_API_KEY)
GROQ_LLM_API_KEY=gsk_account2_llm_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: path to ffmpeg binary or directory if not in PATH
FFMPEG_LOCATION=

